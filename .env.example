# Configuración del Webhook de Meta
VERIFY_TOKEN=tu_token_de_verificacion

# API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_gemini_api_key
# Opcional: modelo a usar (por defecto gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=tu_whatsapp_token
WHATSAPP_PHONE_ID=tu_phone_number_id
WHATSAPP_API_VERSION=v21.0

# URL pública del webhook (ngrok u otro túnel)
WEBHOOK_URL=https://tu-subdominio.ngrok-free.dev/webhook/whatsapp
